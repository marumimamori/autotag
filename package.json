{
	"name": "autotag",
	"version": "0.1.2",
	"description": "Create and enrich companion notes for files using folder tags, AI tags, geolocation, duplicate protection, and recovery tools.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"autotag",
		"companion-notes"
	],
	"author": "marumimamori",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marumimamori/autotag.git"
	},
	"bugs": {
		"url": "https://github.com/marumimamori/autotag/issues"
	},
	"homepage": "https://github.com/marumimamori/autotag#readme",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
